<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ site.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="/">
        <span class="brand-mark">K</span>
        <span class="brand-text">{{ site.title }}</span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Buka menu" aria-expanded="false">&#9776;</button>
      <nav class="nav" id="nav">
        <a href="/" {% if page.url == "/" %}class="active"{% endif %}>Beranda</a>
        <a href="/kamar/" {% if page.url == "/kamar/" %}class="active"{% endif %}>Kamar</a>
        <a href="/fasilitas/" {% if page.url == "/fasilitas/" %}class="active"{% endif %}>Fasilitas</a>
        <a href="/tentang/" {% if page.url == "/tentang/" %}class="active"{% endif %}>Tentang</a>
        <a href="/kontak/" {% if page.url == "/kontak/" %}class="active"{% endif %}>Kontak</a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <div class="footer-brand">
          <span class="brand-mark">K</span>
          {{ site.title }}
        </div>
        <p class="footer-about">{{ site.description }}</p>
      </div>
      <div>
        <h4>Menu</h4>
        <ul>
          <li><a href="/">Beranda</a></li>
          <li><a href="/kamar/">Kamar</a></li>
          <li><a href="/fasilitas/">Fasilitas</a></li>
          <li><a href="/tentang/">Tentang</a></li>
          <li><a href="/kontak/">Kontak</a></li>
        </ul>
      </div>
      <div>
        <h4>Hubungi Kami</h4>
        <ul>
          <li>{{ site.alamat }}</li>
          <li>{{ site.phone }}</li>
          <li>{{ site.email }}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>&copy; {{ "" | currentYear }} {{ site.title }}. Seluruh hak cipta dilindungi.</p>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var toggle = document.getElementById("navToggle");
      var nav = document.getElementById("nav");
      if (toggle && nav) {
        toggle.addEventListener("click", function () {
          var open = nav.classList.toggle("open");
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        });
      }
    })();
  </script>
</body>
</html>
