---
title: Kontak
layout: base.njk
---

<section class="page-hero">
  <h1>Hubungi Kami</h1>
  <p>Untuk reservasi atau pertanyaan, silakan hubungi kami.</p>
</section>

<section class="page-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-card">
        <h3>Alamat</h3>
        <p>{{ site.alamat }}</p>
      </div>

      <div class="contact-card">
        <h3>Telepon</h3>
        <p>{{ site.phone }}</p>
      </div>

      <div class="contact-card">
        <h3>Email</h3>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>

      <div class="contact-card">
        <h3>Jam Layanan</h3>
        <p>Resepsionis dan room service 24 jam.</p>
      </div>
    </div>
  </div>
</section>
